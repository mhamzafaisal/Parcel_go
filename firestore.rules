rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isRider() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'rider';
    }

    // Rider online ho aur uske paas pehle se koi active job na ho
    function riderIsFree() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.role == 'rider'
        && u.isOnline == true
        && u.get('activeJobId', null) == null;
    }

    // Maujooda shipment ka customer
    function ownsShipment(shipmentId) {
      return get(/databases/$(database)/documents/shipments/$(shipmentId)).data.customerId == request.auth.uid;
    }

    // Customer ya assigned rider
    function canViewShipment(shipmentId) {
      let s = get(/databases/$(database)/documents/shipments/$(shipmentId)).data;
      return s.customerId == request.auth.uid || s.riderId == request.auth.uid;
    }

    // Isi batch mein ban rahi shipment ka customer
    function willOwnShipment(shipmentId) {
      return getAfter(/databases/$(database)/documents/shipments/$(shipmentId)).data.customerId == request.auth.uid;
    }

    // Isi commit ke baad is shipment ka rider wohi hoga
    function riderAssignedAfter(shipmentId) {
      let s = getAfter(/databases/$(database)/documents/shipments/$(shipmentId)).data;
      return s.riderId == request.auth.uid && s.status == 'assigned';
    }

    // Isi commit ke baad job is rider ke naam "taken" hoga
    function jobTakenBy(jobId, uid) {
      let j = getAfter(/databases/$(database)/documents/jobs/$(jobId)).data;
      return j.status == 'taken' && j.riderId == uid;
    }

    // Job ki cheezein shipment se milti hon
    function shipmentMatchesJob(id, job) {
      let s = getAfter(/databases/$(database)/documents/shipments/$(id)).data;
      return s.customerId == request.auth.uid
        && s.price == job.price
        && s.pickup == job.pickup
        && s.drop == job.drop;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'phone', 'role', 'isOnline', 'rating', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.role in ['customer', 'rider']
        && request.resource.data.rating == 0
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'isOnline', 'location', 'locationAt', 'activeJobId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.isOnline is bool
        && (request.resource.data.isOnline == resource.data.isOnline
            || resource.data.role == 'rider')
        && (!('location' in request.resource.data)
            || (request.resource.data.location.lat is number
                && request.resource.data.location.lng is number))
        && (!('activeJobId' in request.resource.data.diff(resource.data).affectedKeys())
            || (resource.data.get('activeJobId', null) == null
                && request.resource.data.activeJobId is string
                && jobTakenBy(request.resource.data.activeJobId, uid)));

      allow delete: if false;
    }

    match /shipments/{shipmentId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'trackingId', 'customerId', 'riderId', 'status', 'pickup', 'drop',
             'category', 'size', 'weightKg', 'fragile', 'speed', 'receiverName',
             'receiverPhone', 'notes', 'hasPhoto', 'price', 'etaMinutes',
             'roadKm', 'priceLines', 'paymentMethod', 'payer', 'createdAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.trackingId == shipmentId
        && request.resource.data.riderId == null
        && request.resource.data.status == 'created'
        && request.resource.data.category in ['documents', 'clothes', 'electronics', 'food', 'other']
        && request.resource.data.size in ['small', 'medium', 'large']
        && request.resource.data.speed in ['standard', 'express']
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg >= 0.1
        && request.resource.data.weightKg <= 25
        && request.resource.data.price is int
        && request.resource.data.price >= 150
        && request.resource.data.price <= 50000
        && request.resource.data.paymentMethod == 'cash'
        && request.resource.data.payer in ['sender', 'receiver']
        && request.resource.data.receiverName is string
        && request.resource.data.receiverName.size() >= 2
        && request.resource.data.receiverName.size() <= 60
        && request.resource.data.receiverPhone.matches('^\\+923[0-9]{9}$')
        && request.resource.data.notes.size() <= 150
        && request.resource.data.pickup.address is string
        && request.resource.data.pickup.lat is number
        && request.resource.data.pickup.lng is number
        && request.resource.data.drop.address is string
        && request.resource.data.drop.lat is number
        && request.resource.data.drop.lng is number
        && request.resource.data.createdAt == request.time;

      // Rider job accept karta hai: created se assigned, sirf apne naam
      allow update: if signedIn()
        && resource.data.riderId == null
        && resource.data.status == 'created'
        && request.resource.data.status == 'assigned'
        && request.resource.data.riderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'riderId', 'assignedAt'])
        && request.resource.data.assignedAt == request.time
        && jobTakenBy(shipmentId, request.auth.uid);

      allow delete: if false;

      match /events/{eventId} {
        allow read: if signedIn() && canViewShipment(shipmentId);

        allow create: if signedIn()
          && willOwnShipment(shipmentId)
          && request.resource.data.keys().hasOnly(['status', 'at', 'by'])
          && request.resource.data.status == 'created'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['status', 'at', 'by'])
          && request.resource.data.status == 'assigned'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && riderAssignedAfter(shipmentId);

        allow update, delete: if false;
      }

      match /photos/{photoId} {
        allow read: if signedIn() && canViewShipment(shipmentId);

        allow create: if signedIn()
          && willOwnShipment(shipmentId)
          && photoId == 'main'
          && request.resource.data.keys().hasOnly(['data', 'createdAt'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 307200
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      // OTP sirf customer padh sakta hai. Rider ko nahi.
      match /secret/{docId} {
        allow read: if signedIn() && ownsShipment(shipmentId);

        allow create: if signedIn()
          && willOwnShipment(shipmentId)
          && docId == 'otp'
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code is string
          && request.resource.data.code.size() == 6;

        allow update, delete: if false;
      }
    }

    match /jobs/{jobId} {
      // Rider sirf khule jobs dekhe; customer aur assigned rider apna job
      allow read: if signedIn() && (
        (resource.data.status == 'open' && isRider())
        || resource.data.customerId == request.auth.uid
        || resource.data.riderId == request.auth.uid);

      // Job sirf usi batch mein ban sakta hai jisme uski shipment ban rahi ho
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'trackingId', 'customerId', 'status', 'riderId', 'pickup', 'drop',
             'category', 'size', 'weightKg', 'fragile', 'speed', 'price',
             'riderEarning', 'roadKm', 'createdAt'])
        && request.resource.data.trackingId == jobId
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.riderId == null
        && shipmentMatchesJob(jobId, request.resource.data)
        && request.resource.data.riderEarning is int
        && request.resource.data.riderEarning >= 0
        && request.resource.data.riderEarning <= request.resource.data.price
        && request.resource.data.createdAt == request.time;

      // Accept: sirf khula job, sirf free online rider, sirf apne naam
      allow update: if signedIn()
        && resource.data.status == 'open'
        && resource.data.riderId == null
        && request.resource.data.status == 'taken'
        && request.resource.data.riderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'riderId', 'takenAt'])
        && request.resource.data.takenAt == request.time
        && riderIsFree();

      allow delete: if false;
    }
  }
}